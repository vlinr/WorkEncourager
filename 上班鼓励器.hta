<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<title>上班鼓励器</title>
<hta:application
  id="app"
  applicationname="WorkEncourager"
  border="thin"
  caption="yes"
  showintaskbar="yes"
  singleinstance="yes"
  sysmenu="yes"
  windowstate="normal"
  maximizebutton="no"
  navigable="no"
  contextmenu="no"
  selection="no" />
<style>
  * { margin: 0; padding: 0; }
  html, body { height: 100%; overflow: hidden; }
  body {
    font-family: "Microsoft YaHei", sans-serif;
    background: #1a1730;
    color: #f0f0f5;
    user-select: none;
    cursor: default;
  }
  .hidden { display: none; }

  /* ---------- 背景装饰光斑 ---------- */
  .glow { position: absolute; border-radius: 50%; filter: blur(60px); opacity: 0.35; z-index: 0; }
  .glow1 { width: 380px; height: 380px; left: -120px; top: -120px; background: #6a3ec9; }
  .glow2 { width: 320px; height: 320px; right: -100px; bottom: -100px; background: #c93e5e; }

  /* ---------- 标题 ---------- */
  .head { position: relative; z-index: 2; text-align: center; padding-top: 18px; }
  .head h1 { font-size: 26px; letter-spacing: 6px; color: #ffd700; text-shadow: 0 0 18px rgba(255,215,0,0.45); }
  .head p { margin-top: 4px; font-size: 12px; color: #9a9ab0; letter-spacing: 2px; }

  /* ---------- 设置面板 ---------- */
  #panelSetup { position: relative; z-index: 2; width: 660px; margin: 16px auto 0; }
  .grid2 { width: 660px; }
  .fcell { display: inline-block; vertical-align: top; width: 318px; margin: 0 10px 14px 0; }
  .fcell label { display: block; font-size: 12px; color: #9a9ab0; margin-bottom: 6px; letter-spacing: 1px; }
  .fcell input {
    width: 300px; padding: 9px 10px; font-size: 17px; color: #fff;
    background: #100e1f; border: 1px solid #3a3654; border-radius: 8px; outline: none;
    font-family: "Microsoft YaHei", sans-serif;
  }
  .fcell input:focus { border-color: #ffd700; }
  .seg { float: right; margin-top: -2px; }
  .seg-btn {
    display: inline-block; padding: 2px 12px; font-size: 11px; color: #9a9ab0;
    background: #100e1f; border: 1px solid #3a3654; cursor: pointer; letter-spacing: 1px;
  }
  .seg-btn.first { border-radius: 6px 0 0 6px; }
  .seg-btn.last { border-radius: 0 6px 6px 0; border-left: 0; }
  .seg-btn.on { color: #120f22; background: #ffd700; border-color: #ffd700; font-weight: bold; }
  .f-hint { margin-top: 6px; font-size: 11px; color: #7a7a92; min-height: 15px; }
  .setup-tip { text-align: center; font-size: 12px; color: #7a7a92; margin: 2px 0 14px; }

  /* ---------- 按钮 ---------- */
  .btn {
    font-family: "Microsoft YaHei", sans-serif;
    font-size: 17px; letter-spacing: 3px; color: #fff;
    padding: 11px 44px; border: 0; border-radius: 999px; cursor: pointer;
  }
  .btn:active { opacity: 0.8; }
  .btn-start { background: #e0431e; border-bottom: 3px solid #a32e10; }
  .btn-stop  { background: #1f9d57; border-bottom: 3px solid #14703d; }
  .btn-ghost { background: #3a3654; border-bottom: 3px solid #26233c; font-size: 15px; padding: 10px 34px; }
  .btn[disabled] { background: #33304a; border-bottom: 3px solid #26233c; color: #6b6880; cursor: not-allowed; }
  .btnrow { text-align: center; margin-top: 6px; }

  /* ---------- 工作面板 ---------- */
  #panelWork { position: relative; z-index: 2; width: 700px; margin: 10px auto 0; text-align: center; }
  #bigClock { font-family: Consolas, monospace; font-size: 46px; color: #ffffff; letter-spacing: 3px; text-shadow: 0 0 16px rgba(255,255,255,0.25); }
  .clock-label { font-size: 12px; color: #9a9ab0; letter-spacing: 2px; margin-top: 2px; }

  .money-box { margin-top: 14px; padding: 18px 10px 22px; background: #120f22; border: 1px solid #3a3654; border-radius: 14px; }
  .money-label { font-size: 13px; color: #9a9ab0; letter-spacing: 3px; }
  #money {
    margin-top: 8px; font-family: Consolas, "Courier New", monospace; font-weight: bold;
    color: #ff2d2d; text-shadow: 0 0 14px rgba(255,45,45,0.65), 0 0 40px rgba(255,45,45,0.3);
    white-space: nowrap;
  }
  #mInt { font-size: 66px; letter-spacing: 2px; }
  #mDec { font-size: 34px; color: #ff6b5e; }
  #mUnit { font-size: 22px; color: #ff9a8f; margin-left: 8px; }

  .bar-wrap { width: 620px; height: 14px; margin: 18px auto 0; background: #100e1f; border: 1px solid #3a3654; border-radius: 999px; overflow: hidden; }
  #barFill { height: 100%; width: 0%; background: #e0431e; border-radius: 999px; }
  #barFill.ot { background: #ffd700; }
  #barInfo { width: 620px; margin: 6px auto 0; font-size: 12px; color: #9a9ab0; }
  #barInfo .l { float: left; }
  #barInfo .r { float: right; }

  #statusLine { margin-top: 14px; font-size: 15px; color: #ffd700; letter-spacing: 1px; min-height: 22px; }
  #statusLine.ot { color: #ff5252; font-weight: bold; }

  .srow { margin-top: 10px; font-size: 12px; color: #7a7a92; }
  .srow .chip { display: inline-block; margin: 0 8px; padding: 3px 12px; background: #120f22; border: 1px solid #3a3654; border-radius: 999px; }

  .work-btns { margin-top: 16px; }
  .work-btns .btn { margin: 0 8px; }
  #stopTip { margin-top: 10px; font-size: 12px; color: #6b6880; }
  #stopTip.ok { color: #2ecc71; font-weight: bold; }

  /* ---------- 汇总弹窗 ---------- */
  #modal {
    position: fixed; left: 0; top: 0; right: 0; bottom: 0; z-index: 50;
    background: rgba(8,6,18,0.82); text-align: center;
  }
  .modal-box {
    width: 560px; margin: 52px auto 0; padding: 28px 34px 26px;
    background: #1c1832; border: 1px solid #4a4568; border-radius: 18px;
    box-shadow: 0 24px 70px rgba(0,0,0,0.6);
  }
  .modal-emoji { font-size: 44px; }
  .modal-box h2 { margin-top: 6px; font-size: 24px; color: #ffd700; letter-spacing: 4px; text-shadow: 0 0 16px rgba(255,215,0,0.4); }
  #sumTotal {
    margin-top: 12px; font-family: Consolas, monospace; font-weight: bold; font-size: 56px;
    color: #ff2d2d; text-shadow: 0 0 16px rgba(255,45,45,0.6);
  }
  #sumTotal .u { font-size: 20px; color: #ff9a8f; margin-left: 6px; }
  .sum-table { width: 100%; margin-top: 14px; border-collapse: collapse; }
  .sum-table td { padding: 7px 10px; font-size: 14px; border-bottom: 1px dashed #3a3654; }
  .sum-table .k { text-align: left; color: #9a9ab0; }
  .sum-table .v { text-align: right; color: #fff; font-family: Consolas, monospace; }
  .sum-table .v.gold { color: #ffd700; }
  #sumQuote { margin-top: 14px; font-size: 13px; color: #9a9ab0; font-style: italic; }
  .modal-btns { margin-top: 18px; }
  .modal-btns .btn { margin: 0 6px; }

  /* ---------- 庆祝彩带画布 ---------- */
  #confetti { position: fixed; left: 0; top: 0; z-index: 60; pointer-events: none; }
</style>
</head>
<body>
  <div class="glow glow1"></div>
  <div class="glow glow2"></div>

  <div class="head">
    <h1>&#128176; 上班鼓励器</h1>
    <p>上 班 的 每 一 秒 ， 都 是 真 金 白 银</p>
  </div>

  <!-- ================= 设置面板 ================= -->
  <div id="panelSetup">
    <div class="grid2">
      <div class="fcell">
        <label>&#9200; 上班时间</label>
        <input type="time" id="inStart" value="09:00">
      </div>
      <div class="fcell">
        <label>&#127769; 下班时间（正常）</label>
        <input type="time" id="inEnd" value="18:00">
      </div>
      <div class="fcell">
        <label>&#128176; 薪资
          <span class="seg">
            <span class="seg-btn first on" id="segDay">日薪</span><span class="seg-btn last" id="segMonth">月薪</span>
          </span>
        </label>
        <input type="text" id="inDaily" value="500">
        <p class="f-hint" id="salaryHint">单位：元 / 天，按日薪直接结算</p>
      </div>
      <div class="fcell">
        <label>&#9889; 加班时薪（元 / 小时）</label>
        <input type="text" id="inOt" value="50">
      </div>
    </div>
    <p class="setup-tip">提示：若下班时间早于上班时间，将自动视为跨零点到次日下班；超过下班时间的部分按加班时薪计费。</p>
    <div class="btnrow">
      <button class="btn btn-start" id="btnStart">&#128640; 开始上班</button>
    </div>
  </div>

  <!-- ================= 工作面板 ================= -->
  <div id="panelWork" class="hidden">
    <div id="bigClock">--:--:--</div>
    <div class="clock-label">当 前 时 间</div>

    <div class="money-box">
      <div class="money-label">&#128184; 今 日 已 赚</div>
      <div id="money">
        <span id="mInt">0</span><span id="mDec">.0000</span><span id="mUnit">元</span>
      </div>
    </div>

    <div class="bar-wrap"><div id="barFill"></div></div>
    <div id="barInfo">
      <span class="l" id="barL">00:00</span>
      <span class="r" id="barR">--:--</span>
    </div>

    <div id="statusLine">准备开工！</div>

    <div class="srow">
      <span class="chip" id="chipBasis">计薪口径：--</span>
      <span class="chip" id="chipShift">班次：--:-- ~ --:--</span>
      <span class="chip" id="chipNormal">正常时薪：--</span>
      <span class="chip" id="chipOt">加班时薪：--</span>
      <span class="chip" id="chipOtTime">已加班：00:00:00</span>
    </div>

    <div class="work-btns">
      <button class="btn btn-stop" id="btnStop" disabled>&#127937; 下班结算</button>
      <button class="btn btn-ghost" id="btnCancel">&#10006; 放弃本次</button>
    </div>
    <div id="stopTip">未到下班时间，暂不能下班哦，继续加油！</div>
  </div>

  <!-- ================= 汇总弹窗 ================= -->
  <div id="modal" class="hidden">
    <div class="modal-box">
      <div class="modal-emoji">&#127881;&#128176;&#127881;</div>
      <h2>下 班 啦 ！ 辛 苦 了 ！</h2>
      <div id="sumTotal">0.0000<span class="u">元</span></div>
      <table class="sum-table">
        <tr><td class="k">上班时间</td><td class="v" id="sumStart">--</td></tr>
        <tr><td class="k">下班时间</td><td class="v" id="sumEnd">--</td></tr>
        <tr><td class="k">正常班次</td><td class="v" id="sumShift">--</td></tr>
        <tr><td class="k">计薪口径</td><td class="v" id="sumBasis">--</td></tr>
        <tr><td class="k">正常薪资</td><td class="v" id="sumNormal">--</td></tr>
        <tr><td class="k">加班时长</td><td class="v gold" id="sumOtDur">--</td></tr>
        <tr><td class="k">加班费</td><td class="v gold" id="sumOtPay">--</td></tr>
      </table>
      <p id="sumQuote">今天的你，也在认真搞钱，棒！</p>
      <div class="modal-btns">
        <button class="btn btn-start" id="btnAgain">&#128260; 再来一天</button>
        <button class="btn btn-ghost" id="btnCloseApp">&#128682; 关闭程序</button>
      </div>
    </div>
  </div>

  <canvas id="confetti" class="hidden"></canvas>

<script type="text/javascript">
/* ================= 全局状态 ================= */
var timerId = null;
var S = null;            // 班次配置
var salaryMode = "day";  // day=日薪（默认） | month=月薪
var MONTH_DAYS = 21.75;  // 国家法定月计薪天数
var started = false;     // 是否已开始上班
var stopArmed = false;   // 到点提醒是否已触发
var audioCtx = null;

var QUOTES = [
  "今天的你，也在认真搞钱，棒！",
  "钱不会辜负每一个努力上班的人！",
  "下班快乐！今天的汗水已变成余额！",
  "打工虽苦，但到账的瞬间很甜！",
  "又是被自己赚钱能力折服的一天！"
];

function $id(id) { return document.getElementById(id); }
function pad(n) { return (n < 10 ? "0" : "") + n; }

/* ================= 音效（Web Audio，失败则静默） ================= */
function getCtx() {
  try {
    if (!audioCtx) {
      var AC = window.AudioContext || window.webkitAudioContext;
      if (AC) audioCtx = new AC();
    }
  } catch (e) { audioCtx = null; }
  return audioCtx;
}
function playNote(freq, beginOffset, dur, vol) {
  var ctx = getCtx();
  if (!ctx) return;
  try {
    var t0 = ctx.currentTime + beginOffset;
    var osc = ctx.createOscillator();
    var g = ctx.createGain();
    osc.type = "triangle";
    osc.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.12, t0);
    g.gain.exponentialRampToValueAtTime(0.001, t0 + dur);
    osc.connect(g); g.connect(ctx.destination);
    osc.start(t0); osc.stop(t0 + dur + 0.02);
  } catch (e) {}
}
function playStartSound() {
  playNote(659, 0, 0.12); playNote(880, 0.12, 0.18);
}
function playBell() {
  playNote(1046, 0, 0.5, 0.18); playNote(1318, 0.15, 0.5, 0.15); playNote(1568, 0.3, 0.7, 0.15);
}
function playCelebration() {
  var melody = [523, 523, 659, 784, 784, 659, 523, 587, 659, 587, 523];
  for (var i = 0; i < melody.length; i++) playNote(melody[i], i * 0.18, 0.17, 0.12);
}

/* ================= 时间工具 ================= */
function hmToSec(hhmm) {
  var p = hhmm.split(":");
  return (parseInt(p[0], 10) * 3600) + (parseInt(p[1], 10) * 60);
}
function fmtDur(sec) {
  if (sec < 0) sec = 0;
  sec = Math.floor(sec);
  return pad(Math.floor(sec / 3600)) + ":" + pad(Math.floor((sec % 3600) / 60)) + ":" + pad(sec % 60);
}
function fmtHM(sec) {
  return pad(Math.floor(sec / 3600)) + ":" + pad(Math.floor((sec % 3600) / 60));
}
function nowOfDaySec() {
  var d = new Date();
  return d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds() + d.getMilliseconds() / 1000;
}
function secondsIntoShift(d) {
  // 当前时刻距离上班时间已过去多少秒（支持跨零点，窗口 48 小时）
  var cur = d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds() + d.getMilliseconds() / 1000;
  var diff = cur - S.startSec;
  if (diff < -43200) diff += 86400;
  return diff;
}
function earnedAt(d) {
  var e = secondsIntoShift(d);
  if (e <= 0) return 0;
  if (e <= S.shiftLen) return e * S.normalPerSec;
  return S.daily + (e - S.shiftLen) * (S.otRate / 3600);
}

/* ================= 金额显示（截断到 4 位小数） ================= */
function setMoney(v) {
  if (v < 0) v = 0;
  var s = v.toFixed(4).split(".");
  $id("mInt").innerHTML = s[0];
  $id("mDec").innerHTML = "." + s[1];
}

/* ================= 薪资口径切换 ================= */
function setSalaryMode(m) {
  salaryMode = m;
  $id("segDay").className = "seg-btn first" + (m === "day" ? " on" : "");
  $id("segMonth").className = "seg-btn last" + (m === "month" ? " on" : "");
  updateSalaryHint();
}
function updateSalaryHint() {
  var v = parseFloat($id("inDaily").value);
  var hint = $id("salaryHint");
  if (salaryMode === "day") {
    hint.innerHTML = "单位：元 / 天，按日薪直接结算";
  } else if (v > 0) {
    hint.innerHTML = "按法定月计薪天数 21.75 折算：日薪 = " + (v / MONTH_DAYS).toFixed(2) + " 元";
  } else {
    hint.innerHTML = "单位：元 / 月，按法定月计薪天数 21.75 折算日薪";
  }
}

/* ================= 开始上班 ================= */
function onStart() {
  var sv = $id("inStart").value;
  var ev = $id("inEnd").value;
  var rawSalary = parseFloat($id("inDaily").value);
  var ov = parseFloat($id("inOt").value);

  if (!sv || !ev) { alert("请选择上班时间和下班时间！"); return; }
  if (!(rawSalary > 0)) { alert(salaryMode === "day" ? "请输入正确的日薪（大于 0 的数字）！" : "请输入正确的月薪（大于 0 的数字）！"); return; }
  if (isNaN(ov) || ov < 0) ov = 0;

  var dv = salaryMode === "month" ? rawSalary / MONTH_DAYS : rawSalary;

  var startSec = hmToSec(sv);
  var endSec = hmToSec(ev);
  var shiftLen = endSec - startSec;
  if (shiftLen <= 0) shiftLen += 86400;   // 跨零点

  S = {
    startStr: sv, endStr: ev,
    startSec: startSec, endSec: endSec,
    shiftLen: shiftLen,
    daily: dv,
    rawSalary: rawSalary,
    salaryMode: salaryMode,
    normalPerSec: dv / shiftLen,
    otRate: ov
  };

  started = true;
  stopArmed = false;

  $id("panelSetup").className = "hidden";
  $id("panelWork").className = "";
  $id("chipBasis").innerHTML = salaryMode === "day"
    ? "计薪口径：日薪 " + rawSalary.toFixed(2) + " 元"
    : "计薪口径：月薪 " + rawSalary.toFixed(2) + " → 日薪 " + dv.toFixed(2) + " 元";
  $id("chipShift").innerHTML = "班次：" + sv + " ~ " + ev + (shiftLen !== endSec - startSec ? "（次日）" : "");
  $id("chipNormal").innerHTML = "正常时薪：" + (dv / (shiftLen / 3600)).toFixed(2) + " 元";
  $id("chipOt").innerHTML = "加班时薪：" + ov.toFixed(2) + " 元";
  $id("btnStop").disabled = true;
  $id("stopTip").className = "";
  $id("stopTip").innerHTML = "未到下班时间，暂不能下班哦，继续加油！";

  playStartSound();
  timerId = setInterval(tick, 60);
  tick();
}

/* ================= 每秒刷新 ================= */
function tick() {
  var d = new Date();
  $id("bigClock").innerHTML = pad(d.getHours()) + ":" + pad(d.getMinutes()) + ":" + pad(d.getSeconds());

  var e = secondsIntoShift(d);
  var earned = earnedAt(d);
  setMoney(earned);

  // 进度条
  var pct = e / S.shiftLen * 100;
  if (pct < 0) pct = 0;
  if (pct > 100) pct = 100;
  var fill = $id("barFill");
  fill.style.width = pct + "%";
  $id("barL").innerHTML = "已上班 " + (e > 0 ? fmtDur(e) : "00:00:00");
  $id("barR").innerHTML = S.endStr + " 下班";

  var st = $id("statusLine");
  var tip = $id("stopTip");

  if (e < 0) {
    // 还没到上班时间
    fill.className = "";
    st.className = "";
    st.innerHTML = "&#127749; 还没到上班时间，提前到岗也是热爱！目前薪资从上班时间开始累计。";
    $id("chipOtTime").innerHTML = "已加班：00:00:00";
  } else if (e <= S.shiftLen) {
    // 正常上班中
    fill.className = "";
    st.className = "";
    st.innerHTML = "&#128188; 努力工作中… 距离下班还有 " + fmtDur(S.shiftLen - e) + " ，每秒进账 " + S.normalPerSec.toFixed(4) + " 元！";
    $id("chipOtTime").innerHTML = "已加班：00:00:00";
  } else {
    // 加班中
    fill.className = "ot";
    st.className = "ot";
    st.innerHTML = "&#128293; 加班中！时薪 " + S.otRate.toFixed(2) + " 元火力全开，已多赚 " + (earned - S.daily).toFixed(4) + " 元！";
    $id("chipOtTime").innerHTML = "已加班：" + fmtDur(e - S.shiftLen);
  }

  // 到点解锁下班按钮
  if (e >= S.shiftLen && !stopArmed) {
    stopArmed = true;
    $id("btnStop").disabled = false;
    tip.className = "ok";
    tip.innerHTML = "&#10004; 已到下班时间，随时可以下班结算！";
    playBell();
  }
}

/* ================= 下班结算 ================= */
function onStop() {
  if (!started) return;
  var btn = $id("btnStop");
  btn.disabled = true;               // 防重复点击
  clearInterval(timerId); timerId = null;

  var d = new Date();
  var e = secondsIntoShift(d);
  var normalPay = S.daily;
  var otSec = e > S.shiftLen ? e - S.shiftLen : 0;
  var otPay = otSec * (S.otRate / 3600);
  var total = normalPay + otPay;

  $id("sumStart").innerHTML = S.startStr;
  $id("sumEnd").innerHTML = pad(d.getHours()) + ":" + pad(d.getMinutes());
  $id("sumShift").innerHTML = S.startStr + " ~ " + S.endStr + (S.shiftLen !== S.endSec - S.startSec ? "（次日）" : "");
  $id("sumBasis").innerHTML = S.salaryMode === "day"
    ? "日薪 " + S.rawSalary.toFixed(4) + " 元"
    : "月薪 " + S.rawSalary.toFixed(4) + " 元 ÷ 21.75 = 日薪 " + S.daily.toFixed(4) + " 元";
  $id("sumNormal").innerHTML = normalPay.toFixed(4) + " 元";
  $id("sumOtDur").innerHTML = fmtDur(otSec);
  $id("sumOtPay").innerHTML = otPay.toFixed(4) + " 元";
  $id("sumTotal").innerHTML = total.toFixed(4) + "<span class='u'>元</span>";
  $id("sumQuote").innerHTML = QUOTES[Math.floor(Math.random() * QUOTES.length)];

  $id("modal").className = "";
  startConfetti();
  playCelebration();
  started = false;
}

/* ================= 放弃本次 / 再来一天 ================= */
function onCancel() {
  if (confirm("确定放弃本次上班记录吗？累计薪资将清零。")) {
    clearInterval(timerId); timerId = null;
    started = false; stopArmed = false;
    backToSetup();
  }
}
function onAgain() {
  $id("modal").className = "hidden";
  stopConfetti();
  backToSetup();
}
function backToSetup() {
  $id("panelWork").className = "hidden";
  $id("panelSetup").className = "";
  setMoney(0);
}

/* ================= 彩带庆祝动画 ================= */
var cfCanvas = null, cfCtx = null, cfParts = [], cfRaf = null;
var CF_COLORS = ["#ff2d2d", "#ffd700", "#2ecc71", "#3498db", "#e056fd", "#ff8c00", "#00e5ff"];

function startConfetti() {
  cfCanvas = $id("confetti");
  cfCanvas.className = "";
  cfCanvas.width = document.body.clientWidth;
  cfCanvas.height = document.body.clientHeight;
  cfCtx = cfCanvas.getContext("2d");
  cfParts = [];
  for (var i = 0; i < 220; i++) {
    cfParts.push({
      x: Math.random() * cfCanvas.width,
      y: Math.random() * -cfCanvas.height,
      w: 5 + Math.random() * 7,
      h: 8 + Math.random() * 10,
      vy: 2 + Math.random() * 4,
      vx: -1.5 + Math.random() * 3,
      rot: Math.random() * 360,
      vr: -6 + Math.random() * 12,
      color: CF_COLORS[Math.floor(Math.random() * CF_COLORS.length)],
      phase: Math.random() * Math.PI * 2
    });
  }
  if (cfRaf) cancelAnimationFrame(cfRaf);
  cfLoop();
}
function cfLoop() {
  if (!cfCtx) return;
  cfCtx.clearRect(0, 0, cfCanvas.width, cfCanvas.height);
  for (var i = 0; i < cfParts.length; i++) {
    var p = cfParts[i];
    p.y += p.vy;
    p.phase += 0.05;
    p.x += p.vx + Math.sin(p.phase) * 1.2;
    p.rot += p.vr;
    if (p.y > cfCanvas.height + 20) { p.y = -20; p.x = Math.random() * cfCanvas.width; }
    cfCtx.save();
    cfCtx.translate(p.x, p.y);
    cfCtx.rotate(p.rot * Math.PI / 180);
    cfCtx.fillStyle = p.color;
    cfCtx.fillRect(-p.w / 2, -p.h / 2, p.w, p.h);
    cfCtx.restore();
  }
  cfRaf = requestAnimationFrame(cfLoop);
}
function stopConfetti() {
  if (cfRaf) { cancelAnimationFrame(cfRaf); cfRaf = null; }
  cfCtx = null;
  $id("confetti").className = "hidden";
}

/* ================= 事件绑定与初始化 ================= */
$id("btnStart").onclick = onStart;
$id("segDay").onclick = function () { setSalaryMode("day"); };
$id("segMonth").onclick = function () { setSalaryMode("month"); };
$id("inDaily").oninput = updateSalaryHint;
$id("inDaily").onpropertychange = updateSalaryHint;
$id("btnStop").onclick = onStop;
$id("btnCancel").onclick = onCancel;
$id("btnAgain").onclick = onAgain;
$id("btnCloseApp").onclick = function () { window.close(); };

window.onresize = function () {
  if (cfCanvas && cfCanvas.className !== "hidden") {
    cfCanvas.width = document.body.clientWidth;
    cfCanvas.height = document.body.clientHeight;
  }
};

window.onload = function () {
  // 窗口居中并设定尺寸
  try {
    window.resizeTo(820, 760);
    var sw = screen.availWidth, sh = screen.availHeight;
    window.moveTo(Math.max(0, (sw - 820) / 2), Math.max(0, (sh - 760) / 2));
  } catch (e) {}
  // 默认班次：周一到周五常见时间，可修改
  setSalaryMode("day");
  setMoney(0);
};
</script>
</body>
</html>
